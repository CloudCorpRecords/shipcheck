{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "description": "Release verification: git tag, release, npm, MCP Registry, and GHCR must agree, or NO-GO.",
  "name": "io.github.CloudCorpRecords/shipcheck",
  "packages": [
    {
      "identifier": "@reneturcios/shipcheck",
      "packageArguments": [
        {
          "type": "positional",
          "value": "mcp"
        }
      ],
      "registryBaseUrl": "https://registry.npmjs.org",
      "registryType": "npm",
      "runtimeHint": "npx",
      "transport": {
        "type": "stdio"
      },
      "version": "0.1.0"
    },
    {
      "identifier": "ghcr.io/cloudcorprecords/shipcheck:0.1.0",
      "packageArguments": [
        {
          "type": "positional",
          "value": "mcp"
        }
      ],
      "registryType": "oci",
      "runtimeArguments": [
        {
          "name": "--rm",
          "type": "named"
        },
        {
          "name": "-i",
          "type": "named"
        }
      ],
      "runtimeHint": "docker",
      "transport": {
        "type": "stdio"
      }
    }
  ],
  "repository": {
    "source": "github",
    "url": "https://github.com/CloudCorpRecords/shipcheck"
  },
  "version": "0.1.0"
}
